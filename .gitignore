# Правила исключений.

# ------------------------------------------------- секреты и локальный конфиг
# Содержат идентификаторы устройств и ключи доступа. В репозитории им не место.
config.json
config.json.bak

# ---------------------------------------------------------------- сборки C#
csharp/**/bin/
csharp/**/obj/
csharp/Releases/
csharp/dist/
*.user

# Готовые сборки в корне репозитория.
#
# Однажды сюда попали опубликованные файлы: команда публикации была запущена
# из корня, а не из папки csharp, и создала каталоги OpenTuyaSync и
# OpenTuyaSync-v1.0.4. Они попали в репозиторий и раздули его на десятки
# мегабайт. Правила ниже закрывают такую ошибку на будущее.
/OpenTuyaSync/
/OpenTuyaSync-v*/
/Releases/

# Отладочные символы.
*.pdb

