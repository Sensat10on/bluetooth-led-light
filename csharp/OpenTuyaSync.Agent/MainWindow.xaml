<Window x:Class="OpenTuyaSync.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTuya Sync"
        Icon="icon.ico" Height="640" Width="820"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static SystemColors.ControlBrush}"
        FontFamily="Segoe UI" FontSize="12">

    <DockPanel>

        <!-- Строка меню: классическая навигация по разделам. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить настройки" Click="OnSaveSettings" />
                <Separator />
                <MenuItem Header="Свернуть в трей" Click="OnMinimizeToTray" />
                <MenuItem Header="Выход" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="Подсветка">
                <MenuItem Header="Запустить" Click="OnStartCapture" />
                <MenuItem Header="Остановить" Click="OnStopCapture" />
                <Separator />
                <MenuItem Header="Переподключить устройства" Click="OnReconnectDevices" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Строка состояния: что происходит прямо сейчас. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusService" Text="Служба: проверка..." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusCapture" Text="Подсветка: остановлена" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusBackend" Text="Захват: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusBle" Text="Bluetooth: —" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusFrames" Text="Отправлено: 0" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">

            <!-- ============================ АВТОМАТИЧЕСКИ ============================ -->
            <TabItem Header="Автоматически">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Источник цвета">
                        <StackPanel>
                            <RadioButton x:Name="RadioScreen" Content="Ambilight (экран)"
                                         IsChecked="True" Margin="0,2"
                                         Checked="OnSourceChanged" />
                            <RadioButton x:Name="RadioMusic" Content="Режим музыки (звук из колонок)"
                                         Margin="0,2" Checked="OnSourceChanged" />
                            <RadioButton x:Name="RadioFlash" Content="Режим вспышек (стробоскоп)"
                                         Margin="0,2" Checked="OnSourceChanged" />

                            <Grid x:Name="MonitorRow" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Монитор:" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" x:Name="MonitorBox"
                                          SelectionChanged="OnMonitorChanged" />
                            </Grid>

                            <Grid x:Name="AudioRow" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Устройство вывода:" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" x:Name="AudioBox"
                                          SelectionChanged="OnAudioDeviceChanged" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Пределы яркости">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум:" Margin="0,0,8,4" />
                            <Slider Grid.Row="0" Grid.Column="1" x:Name="MinBrightnessSlider"
                                    Minimum="0" Maximum="100" Value="0"
                                    ValueChanged="OnMinBrightnessChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="MinBrightnessText" Text="0%" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум:" Margin="0,0,8,0" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="MaxBrightnessSlider"
                                    Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="OnMaxBrightnessChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MaxBrightnessText" Text="100%" />
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
                        <Button x:Name="StartStopButton" Content="Запустить"
                                Click="OnStartStop" MinWidth="140" FontWeight="SemiBold" />
                        <Button Content="Переподключить устройства" Click="OnReconnectDevices" />
                    </StackPanel>

                    <GroupBox Grid.Row="3" Header="Состояние">
                        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="{x:Static SystemColors.WindowBrush}" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================== ВРУЧНУЮ ============================== -->
            <TabItem Header="Вручную">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Цвет">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Красный:" Margin="0,0,8,4" />
                            <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider"
                                    Minimum="0" Maximum="255" Value="255"
                                    ValueChanged="OnManualColorChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RedText" Text="255" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Зелёный:" Margin="0,0,8,4" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider"
                                    Minimum="0" Maximum="255" Value="255"
                                    ValueChanged="OnManualColorChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GreenText" Text="255" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Синий:" Margin="0,0,8,0" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider"
                                    Minimum="0" Maximum="255" Value="255"
                                    ValueChanged="OnManualColorChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BlueText" Text="255" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Предпросмотр и системный выбор цвета">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ColorPreview" Width="120" Height="40"
                                    BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                    BorderThickness="1" Background="White" />
                            <Button Content="Выбрать цвет..." Click="OnPickColor"
                                    Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Content="Применить цвет" Click="OnApplyManualColor" />
                        <Button Content="Включить" Click="OnManualPowerOn" />
                        <Button Content="Выключить" Click="OnManualPowerOff" />
                    </StackPanel>

                    <GroupBox Grid.Row="3" Header="Подсказка">
                        <TextBlock Style="{StaticResource HintText}" Margin="0">
                            Ручное управление работает, только когда автоматический источник остановлен:
                            иначе движок подсветки будет перебивать выбранный цвет несколько раз в секунду.
                            Ползунки меняют цвет плавно и отправляются на устройство с задержкой,
                            чтобы не перегружать лампу.
                        </TextBlock>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================= НАСТРОЙКИ ============================= -->
            <TabItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- ==== Устройства ==== -->
                        <GroupBox Header="Устройства">
                            <StackPanel>
                                <ListBox x:Name="DeviceList" Height="130"
                                         SelectionChanged="OnDeviceSelected" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Добавить" Click="OnAddDevice" />
                                    <Button Content="Изменить" Click="OnEditDevice" />
                                    <Button Content="Удалить" Click="OnDeleteDevice" />
                                    <Button Content="Проверить связь" Click="OnTestDevice" />
                                </StackPanel>

                                <Separator Margin="0,10,0,6" />
                                <TextBlock Text="Поиск устройства" Style="{StaticResource HeaderText}" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="🔍 Сканировать сеть (Tuya)" Click="OnScanTuya" />
                                    <Button Content="🔍 Поиск по Bluetooth" Click="OnScanBluetooth" />
                                    <Button Content="Остановить поиск" Click="OnCancelScan" IsEnabled="False"
                                            x:Name="CancelScanButton" />
                                </StackPanel>

                                <TextBlock x:Name="ScanStatus" Style="{StaticResource HintText}"
                                           Text="Поиск не запускался." />

                                <ComboBox x:Name="ScanResultsBox" Margin="0,6,0,0"
                                          Visibility="Collapsed"
                                          SelectionChanged="OnScanResultSelected" />

                                <TextBlock Style="{StaticResource HintText}">
                                    Сканирование сети заполняет Device ID, IP и версию протокола.
                                    Local Key из сети получить нельзя: Tuya создаёт его на стороне облака
                                    при сопряжении, и он не передаётся в эфир в открытом виде. Возьмите его
                                    в приложении Smart Life: настройки устройства → информация об устройстве.
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <!-- ==== Редактор устройства ==== -->
                        <GroupBox Header="Параметры выбранного устройства" x:Name="DeviceEditorBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Margin="0,4" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DeviceNameBox" Margin="0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" Margin="0,4" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DeviceTypeBox" Margin="0,2"
                                          SelectionChanged="OnDeviceTypeChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Device ID:" Margin="0,4" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TuyaDevIdBox" Margin="0,2" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="IP:" Margin="0,4" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="IpBox" Margin="0,2" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Local Key:" Margin="0,4" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TuyaKeyBox" Margin="0,2" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Версия протокола:" Margin="0,4" />
                                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TuyaVersionBox" Margin="0,2"
                                          Width="80" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Яркость, %:" Margin="0,4" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                    <Slider x:Name="DeviceBrightnessSlider" Minimum="10" Maximum="200"
                                            Value="100" Width="220"
                                            ValueChanged="OnDeviceBrightnessChanged" />
                                    <TextBlock x:Name="DeviceBrightnessText" Text="100%" Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="DeviceEnabledBox" Content="Устройство включено"
                                              VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Content="Сохранить устройство" Click="OnSaveDevice" />
                                    <Button Content="Сопряжение с Hue" Click="OnPairHue" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- ==== Горячие клавиши ==== -->
                        <GroupBox Header="Горячие клавиши">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8">
                                    Нажмите «Назначить» и затем нужное сочетание клавиш. Регистрация
                                    глобальная -- сочетания работают даже когда окно свёрнуто в трей.
                                    Если сочетание занято другой программой, оно не будет зарегистрировано.
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Запуск / остановка:" Margin="0,4" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyToggleBox"
                                             IsReadOnly="True" Margin="0,2" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="Назначить" Margin="4,2"
                                            Tag="Toggle" Click="OnCaptureHotkey" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Следующий источник:" Margin="0,4" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyNextSourceBox"
                                             IsReadOnly="True" Margin="0,2" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="Назначить" Margin="4,2"
                                            Tag="NextSource" Click="OnCaptureHotkey" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Яркость больше:" Margin="0,4" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeyBrightnessUpBox"
                                             IsReadOnly="True" Margin="0,2" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="Назначить" Margin="4,2"
                                            Tag="BrightnessUp" Click="OnCaptureHotkey" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Яркость меньше:" Margin="0,4" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="HotkeyBrightnessDownBox"
                                             IsReadOnly="True" Margin="0,2" />
                                    <Button Grid.Row="3" Grid.Column="2" Content="Назначить" Margin="4,2"
                                            Tag="BrightnessDown" Click="OnCaptureHotkey" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Применить горячие клавиши" Click="OnApplyHotkeys" />
                                    <Button Content="Очистить все" Click="OnClearHotkeys" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- ==== Система ==== -->
                        <GroupBox Header="Система">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartBox" Content="Запускать при входе в систему"
                                          Margin="0,2" />
                                <CheckBox x:Name="StartMinimizedBox" Content="Запускать свёрнутым в трей"
                                          Margin="0,2" />
                                <CheckBox x:Name="AutoStartCaptureBox"
                                          Content="Автоматически включать подсветку при старте"
                                          Margin="0,2" />
                                <CheckBox x:Name="RestoreSceneBox"
                                          Content="Возвращать лампы в прежнее состояние при остановке"
                                          Margin="0,2" />

                                <Separator Margin="0,10,0,6" />
                                <TextBlock Text="Служба Windows" Style="{StaticResource HeaderText}" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8">
                                    Служба держит подключения к устройствам и продолжает работать,
                                    когда окно закрыто. Захват экрана выполняет это приложение:
                                    служба Windows работает в изолированной сессии и не видит рабочий
                                    стол -- это ограничение операционной системы.
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Установить службу" Click="OnInstallService" />
                                    <Button Content="Удалить службу" Click="OnUninstallService" />
                                    <Button Content="Проверить состояние" Click="OnCheckService" />
                                </StackPanel>

                                <TextBlock x:Name="ServiceStatusText" Style="{StaticResource HintText}"
                                           Text="Состояние службы не проверялось." />
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                            <Button Content="Сохранить все настройки" Click="OnSaveSettings"
                                    FontWeight="SemiBold" />
                            <Button Content="Перечитать из файла" Click="OnReloadSettings" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
