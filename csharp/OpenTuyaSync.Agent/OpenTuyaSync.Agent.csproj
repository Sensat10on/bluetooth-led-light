<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Значок в трее берётся из Windows Forms: в WPF своего нет. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OpenTuyaSync</AssemblyName>
    <RootNamespace>OpenTuyaSync.Agent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Иконка встраивается в исполняемый файл: без этой строки значок
         окна и файла берётся системный, хотя файл иконки лежал рядом.
         ApplicationIcon встраивает её как ресурс Windows, Icon в разметке
         окна показывает в заголовке. -->
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>

    <!-- WinForms предупреждает, что настройки DPI надо задавать через его
         API, а не в манифесте. Предупреждение здесь не по делу: программа
         на WPF, а из WinForms взят только значок в трее. Настройки в
         манифесте при этом верные и нужны: без них интерфейс размывается
         на мониторах с масштабом от 125 %. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- InvariantGlobalization намеренно НЕ включается: WPF разрешает
         культуру для привязок, и в инвариантном режиме падает с
         «Cannot find non-neutral culture related to 'en-us'» при показе
         окна. Экономия от инвариантного режима здесь ничтожна. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка окна: тот же файл, что встроен в исполняемый файл. -->
    <Resource Include="..\assets\icon.ico" Link="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTuyaSync.Core\OpenTuyaSync.Core.csproj" />
    <ProjectReference Include="..\OpenTuyaSync.Capture\OpenTuyaSync.Capture.csproj" />
    <!-- Нужен только ради названий типов устройств в интерфейсе: сама
         работа с устройствами идёт в службе. -->
    <ProjectReference Include="..\OpenTuyaSync.Providers\OpenTuyaSync.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Управление службой через API Windows вместо разбора вывода sc.exe.
         Причина: sc.exe печатает названия полей на языке системы
         («СОСТОЯНИЕ» вместо «STATE»), и разбор текста молча не находил
         состояние службы. Внешне это выглядело как «службу запустить не
         удалось: код 1056» при уже работающей службе.
         Эта библиотека и так входит в релиз: её использует служба. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
