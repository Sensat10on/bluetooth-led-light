@echo off
chcp 65001 >nul
cd /d "%~dp0"

rem Перезапускает ОКНО приложения: закрывает запущенные копии и открывает одну
rem новую.
rem
rem Службу этот сценарий НЕ трогает: для её остановки нужны права
rem администратора. Для полного перезапуска службы есть отдельный файл
rem ПЕРЕЗАПУСК-СЛУЖБЫ.bat.
rem
rem Нужен потому, что запущенная копия держит прежний код в памяти: после
rem обновления программы её надо перезапустить.

rem Закрываем окно, но не значок в трее: значок завершается вместе с процессом.
echo Закрываю запущенные копии OpenTuya Sync...
taskkill /IM OpenTuyaSync.exe /F >nul 2>&1
timeout /t 3 /nobreak >nul

echo Запускаю приложение...
start "" "%~dp0OpenTuyaSync.exe"

echo.
echo Готово. Через несколько секунд проверьте в окне приложения:
echo   внизу должно быть "Служба: подключена"
echo.
echo Если написано "не отвечает" -- служба не запущена. Запустите
echo ПЕРЕЗАПУСК-СЛУЖБЫ.bat, он запросит права администратора.
echo.
echo Причина сбоя связи записана в файл:
echo   %~dp0service_link.log
timeout /t 8 /nobreak >nul
