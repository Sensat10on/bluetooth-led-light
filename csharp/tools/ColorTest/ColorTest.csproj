<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Из Windows Forms берётся только системный диалог выбора цвета:
         в WPF своего нет, а системный привычнее. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OpenTuyaSync.ColorTest</AssemblyName>
    <RootNamespace>OpenTuyaSync.ColorTest</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>

    <!-- WinForms предупреждает, что настройки DPI надо задавать через его
         API, а не в манифесте. Предупреждение здесь не по делу: программа
         на WPF, а из WinForms взят только диалог выбора цвета. Настройки в
         манифесте при этом верные и нужны: без них интерфейс размывается
         на мониторах с масштабом от 125 %. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico" Link="icon.ico" />
  </ItemGroup>

</Project>
